<?xml version="1.0" encoding="utf-8"?>
<!-- The phone key is tied to this phone's keystore, so nothing is backed up
     or moved to a new phone. Pair the new phone instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
