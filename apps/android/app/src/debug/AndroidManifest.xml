<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets a script connect the app to a test server through
     an intent with "server" and "key" extras (see DebugConnectActivity).
     Release builds don't contain this activity. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".debug.DebugConnectActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
