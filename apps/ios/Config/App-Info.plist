<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ADHXAppGroup</key>
	<string>group.$(ADHX_BUNDLE_PREFIX)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(ADHX_BUNDLE_PREFIX).pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>adhx</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>To scan the code on your ADHX.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>To save a post to Photos when you tap Save.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>To reach your ADHX on your home network.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(ADHX_BUNDLE_PREFIX).flush</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
