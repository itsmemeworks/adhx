# Optional X OAuth 2.0 credentials (leave empty until you configure an X app)
# Get these from https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# App URL (for OAuth callback)
# Local: http://localhost:3001 (pnpm dev runs on port 3001)
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Session secret for JWT signing (generate a random string)
# In production, use: openssl rand -base64 32
SESSION_SECRET=

# Database path (defaults to ./data/adhdone.db)
# For Fly.io: /data/adhx.db (mounted volume)
DATABASE_PATH=./data/adhdone.db

# Only enable behind a trusted reverse proxy that overwrites X-Forwarded-For
# and X-Real-IP. Fly deployments use Fly-Client-IP and should leave this unset.
TRUST_PROXY_IP_HEADERS=

# Who may make an account here (optional). Comma-separated emails and/or
# @domain entries, e.g. "me@home.example, @friends.example". Unset or * means
# anyone who can reach this server can sign up. Existing accounts always work.
ALLOWED_EMAILS=

# Sign-in links (there are no passwords). Production needs one of these:
# 1. Resend (https://resend.com): RESEND_API_KEY.
# 2. Your own mail server: SMTP_URL=smtps://user:pass@mail.example.com:465
#    (or smtp://…:587 for STARTTLS; percent-encode @ or : in the password).
# 3. No email at all: EMAIL_LINKS_TO_ADMIN=1. Links wait on the admin page for
#    you to pass on, and only invited emails (ALLOWED_EMAILS) and existing
#    accounts get one. Before anyone is an admin, your own link is printed in
#    the server log so you can sign in the first time.
# In development with none of these, links are printed to the console.
RESEND_API_KEY=
SMTP_URL=
EMAIL_LINKS_TO_ADMIN=
# From address for sign-in emails (with Resend, a domain you verified there)
EMAIL_FROM=ADHX <login@adhx.com>

# Sentry DSN for error tracking (optional)
# Get from https://sentry.io - only enabled in production
SENTRY_DSN=

# Kept media: every saved post's pictures, video and sound are downloaded once,
# in the best quality available, and served by ADHX itself.
# Where files live (defaults to media/ next to the database, e.g. /data/media).
MEDIA_DIR=
# KEEP_MEDIA=off stops downloading (files already kept still play).
KEEP_MEDIA=
# KEEP_BACKFILL=off skips older saves; its cutoff persists across restarts.
KEEP_BACKFILL=
# KEEP_H264=off keeps videos in the codec the source sent. By default VP9,
# AV1 and HEVC are re-encoded to H.264 at the same size so every browser plays them.
KEEP_H264=
# Pause downloading while the media disk has less than this many GB free (default 2).
KEEP_MIN_FREE_GB=
# Largest single file to download (default 4G) and posts downloaded at once (default 2).
KEEP_MAX_FILESIZE=
KEEP_CONCURRENCY=
# The yt-dlp binary (the Docker image sets this; locally it's yt-dlp on PATH).
YTDLP_PATH=

# Search by meaning runs a model on this server (about 400 MB from Hugging Face,
# downloaded once on first start into SEMANTIC_CACHE_DIR, default models/ next
# to the database). SEMANTIC_SEARCH=off turns it off; SEMANTIC_THREADS sets the
# CPU threads it may use (default 2).
SEMANTIC_SEARCH=
SEMANTIC_THREADS=
# Video inference only: 16 frames (default), 8 or 4 over the first 32 seconds.
# Fewer frames reduce work and may miss brief events; kept media stays full quality.
SEMANTIC_VIDEO_MAX_FRAMES=16
# Optional: TypeSafe (Jev) refines search order and names automatic channels/moments.
# Sends search text and public post text, never media files, private tags or account identities.
TYPESAFE_API_KEY=

# Phone app (optional): public install links compiled into the Settings page.
# Defaults are source build guides, not published app downloads. Set these when
# building; Docker accepts matching --build-arg values. Changing a running
# container's environment alone cannot change these client-side links.
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=

# Sync cooldown in minutes (optional, defaults to 1)
# How long users must wait between bookmark syncs by hand
SYNC_COOLDOWN_MINUTES=1

# Automatic X bookmark sync (optional, defaults to 50). Minutes between one
# person's automatic syncs; checked every 5 minutes, so new bookmarks arrive
# within the hour. 0 turns it off.
AUTO_SYNC_EVERY_MINUTES=50

# Comma-separated immutable account IDs to persist as admins on startup.
# For a fresh install, create the account, set its ID here, then restart once.
ADMIN_USER_IDS=

# One-time compatibility bridge for existing deployments only. Every listed
# username must already resolve or startup fails with no promotions. A rejected
# list cannot later promote a new claimant; remove it and recover with IDs.
ADMIN_USERNAMES=

# Right now: distinct people who must save the same kind of thing before it
# becomes a moment (default 3). For a small group of friends try 2; set 1
# when you're the only person on your ADHX.
MOMENT_MIN_SAVERS=

# Docker Compose hooks (not used by pnpm dev). Set the final app URL above.
# ADHX_IMAGE=ghcr.io/itsmemeworks/adhx:<version>
# Or pin a manifest: ghcr.io/itsmemeworks/adhx@sha256:<digest>
# ADHX_PORT=3000
# SEMANTIC_CACHE_DIR=/data/models
