{
  "name": "adhx",
  "version": "2.1.2",
  "description": "Your friends have better taste than the algorithm. A private, self-hosted feed of the best posts from every network, picked by your closest friends and family.",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:reset": "tsx src/lib/db/reset.ts",
    "db:seed": "tsx src/lib/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium webkit",
    "extension:dev": "pnpm --dir extension dev",
    "extension:build": "pnpm --dir extension build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "email:dev": "email dev --dir src/emails --port 3003",
    "prepare": "husky",
    "site:dev": "cd site && next dev --webpack -p 3040",
    "site:build": "cd site && next build --webpack",
    "check:dependencies": "node scripts/security/check-dependencies.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "twitter",
    "x",
    "bookmarks",
    "archive",
    "markdown",
    "nextjs"
  ],
  "author": "Alex Hillman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsmemeworks/adhx.git"
  },
  "homepage": "https://adhx.com",
  "bugs": {
    "url": "https://github.com/itsmemeworks/adhx/issues"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@sentry/node": "^10.76.2",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hls.js": "^1.7.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "nodemailer": "^10.1.7",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.3",
    "sharp": "0.35.5",
    "simple-icons": "^16.35.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "twitter-api-v2": "^1.29.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.9",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^9.1.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "ajv@<6.14.0": "^6.14.0",
      "minimatch@<3.1.3": "^3.1.3",
      "minimatch@9": "^9.0.7",
      "brace-expansion@<2.0.3": "^2.0.3",
      "brace-expansion@^1.0.0": "^1.1.18",
      "flatted@<3.4.2": "^3.4.2",
      "fast-uri@<3.1.2": "^3.1.2",
      "js-yaml@^4.0.0": "^4.3.1",
      "picomatch@<4.0.4": "^4.0.4",
      "rollup@<4.59.0": "^4.59.0",
      "esbuild@<0.25.0": "^0.25.0",
      "postcss@<8.5.10": "^8.5.10",
      "undici@^7.0.0": "^7.29.0",
      "yaml@^2.0.0": "^2.8.3",
      "postcss-selector-parser@<7.1.6": "^7.1.6"
    },
    "allowBuilds": {
      "better-sqlite3@13.0.3": true,
      "esbuild@0.25.12 || 0.28.2": true,
      "unrs-resolver@1.12.2": true,
      "protobufjs@7.6.6": false,
      "onnxruntime-node@1.30.0": false
    }
  }
}
