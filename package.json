{
  "name": "adhx",
  "version": "1.65.6",
  "description": "Save now. Read never. Find always. A Twitter/X bookmark manager for people who bookmark everything and read nothing.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:reset": "tsx src/lib/db/reset.ts",
    "db:seed": "tsx src/lib/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "extension:dev": "pnpm --dir extension dev",
    "extension:build": "pnpm --dir extension build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "email:dev": "email dev --dir src/emails --port 3003",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "twitter",
    "x",
    "bookmarks",
    "archive",
    "markdown",
    "nextjs"
  ],
  "author": "Alex Hillman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsmemeworks/adhx.git"
  },
  "homepage": "https://adhx.com",
  "bugs": {
    "url": "https://github.com/itsmemeworks/adhx/issues"
  },
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hls.js": "^1.7.0",
    "jose": "^6.2.9",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.2",
    "tailwind-merge": "^3.6.0",
    "twitter-api-v2": "^1.29.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.3.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "ajv@<6.14.0": "^6.14.0",
      "minimatch@<3.1.3": "^3.1.3",
      "minimatch@9": "^9.0.7",
      "brace-expansion@<2.0.3": "^2.0.3",
      "brace-expansion@^1.0.0": "^1.1.12",
      "flatted@<3.4.2": "^3.4.2",
      "fast-uri@<3.1.2": "^3.1.2",
      "picomatch@<4.0.4": "^4.0.4",
      "rollup@<4.59.0": "^4.59.0",
      "esbuild@<0.25.0": "^0.25.0",
      "postcss@<8.5.10": "^8.5.10"
    }
  }
}
