# Copy outside the checkout, chmod 600, and fill in the shared worker token.
ADHX_SERVER_URL=https://adhx.example.com
ADHX_WORKER_TOKEN=replace-with-at-least-32-random-characters
ADHX_WORKER_ID=mac-worker

# Native CPU is the safe default; the pinned q4/q8 model stays compatible.
# CoreML is opt-in: set coreml only after measuring latency and memory on your Mac.
# CoreML session initialization falls back to CPU if unsupported.
SEMANTIC_DEVICE=cpu
SEMANTIC_THREADS=2
# Speech and text on screen run on CPU in a separate process that exits when
# idle. off here leaves that work queued on the server for another worker.
# SEMANTIC_SPEECH=on
# SEMANTIC_SCREEN_TEXT=on

# Retained originals are cached privately. Defaults: 4 GiB/file, 8 GiB/cache.
# Optional absolute cache/model paths can be set here; never mount the NAS DB.
# ADHX_WORKER_CACHE_DIR=/absolute/private/cache
# SEMANTIC_CACHE_DIR=/absolute/private/model-cache
# ADHX_WORKER_MAX_FILE_BYTES=4294967296
# ADHX_WORKER_CACHE_BYTES=8589934592
# ADHX_WORKER_POLL_MS=5000
