# Vendor-neutral example. Copy to .env and edit privately; never commit .env.
# Choose a published version/digest containing the features you need.
# For an unreleased branch, build it yourself and set ADHX_IMAGE=adhx:local.
ADHX_IMAGE=ghcr.io/itsmemeworks/adhx:latest
ADHX_DATA_DIR=/path/to/private/adhx-data
ADHX_PROXY_NETWORK=your-proxy-network
NEXT_PUBLIC_APP_URL=https://adhx.example.com
# Generate once: openssl rand -base64 32
SESSION_SECRET=
ALLOWED_EMAILS=you@example.com
EMAIL_LINKS_TO_ADMIN=1
MOMENT_MIN_SAVERS=1

# Optional SMTP or Resend instead of handing links over yourself.
SMTP_URL=
RESEND_API_KEY=
EMAIL_FROM=

# Conservative starting point for a shared server. Measure before increasing.
KEEP_CONCURRENCY=1
KEEP_MIN_FREE_GB=20
KEEP_MAX_FILESIZE=4G
KEEP_BACKFILL=on
KEEP_H264=on
SEMANTIC_SEARCH=on
SEMANTIC_THREADS=1
# Optional lighter video inference: up to 8 frames across the whole video; original unchanged.
SEMANTIC_VIDEO_MAX_FRAMES=16
# Only trust client-IP headers after checking your proxy overwrites them.
TRUST_PROXY_IP_HEADERS=false

# Optional search refinement and X sync. X requires your own developer app.
TYPESAFE_API_KEY=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
AUTO_SYNC_EVERY_MINUTES=0
# Manual cooldown in minutes; independent of the automatic sync interval.
SYNC_COOLDOWN_MINUTES=1
