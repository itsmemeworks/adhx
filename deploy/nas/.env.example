# Copy to .env and fill in. Never commit .env.

# Signs everyone's sign-ins. Make it once and never change it, or everyone is
# signed out (phones stay paired):  openssl rand -base64 32
SESSION_SECRET=

# The address people open: https://adhx.<your-tailnet>.ts.net
NEXT_PUBLIC_APP_URL=https://adhx.tail657e0.ts.net

# A Tailscale auth key for the first start (admin console → Settings → Keys).
# Remove it once the container shows up as "adhx" in your tailnet.
TS_AUTHKEY=

# Who can make an account: emails or @domains, comma-separated. Empty = anyone.
ALLOWED_EMAILS=

# 2 or 3 for a group of friends; 1 when it's just you.
MOMENT_MIN_SAVERS=2

# Optional: refines search results.
TYPESAFE_API_KEY=

# Optional: X bookmark sync. Callback URL in your X app:
#   https://adhx.<your-tailnet>.ts.net/api/auth/twitter/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Where the database and media live on the NAS (default ./data next to this file).
# ADHX_DATA_DIR=/volume1/adhx
